{
  "trigger": {
    "name": "触发器",
    "cat": "input",
    "icon": "zap",
    "desc": "工作流执行入口，支持手动 / 定时 / Webhook 触发。",
    "inputs": [],
    "outputs": [
      {
        "n": "开始",
        "t": "any"
      }
    ],
    "params": [
      {
        "k": "mode",
        "l": "触发方式",
        "t": "combo",
        "o": [
          "手动触发",
          "定时触发",
          "Webhook"
        ],
        "d": "手动触发"
      },
      {
        "k": "cron",
        "l": "Cron 表达式",
        "t": "text",
        "d": "0 9 * * 1-5"
      },
      {
        "k": "path",
        "l": "Webhook 路径",
        "t": "text",
        "d": "/api/run"
      }
    ],
    "kw": "trigger start 开始 入口 启动"
  },
  "userinput": {
    "name": "用户输入",
