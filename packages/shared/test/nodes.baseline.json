  "llm": {
    "name": "LLM 对话",
    "cat": "chat",
    "icon": "bot",
    "caps": [
      "mcp",
      "skill"
    ],
    "desc": "调用大语言模型生成回复，可注入提示词与上下文。",
    "inputs": [
      {
        "n": "提示词",
        "t": "text"
      },
      {
        "n": "上下文",
        "t": "any"
      }
    ],
    "outputs": [
      {
        "n": "回复",
        "t": "text"
      }
    ],
    "params": [
      {
        "k": "model",
        "l": "模型",
        "t": "combo",
        "o": [
          "GLM-4.7",
          "GLM-4.7-Air",
          "GLM-4.6-Flash",
          "DeepSeek-V4",
          "GPT-5",
          "Claude Sonnet 4.5"
        ],
        "d": "GLM-4.7"
      },
      {
        "k": "sys",
        "l": "系统提示词",
        "t": "textarea",
        "d": "你是智能客服助手，回答需准确、简洁、友好。"
      },
      {
        "k": "temp",
        "l": "温度",
        "t": "number",
        "d": 0.7,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "k": "max",
        "l": "最大 Tokens",
        "t": "number",
        "d": 2048,
        "min": 64,
        "max": 32768,
        "step": 64
      }
    ],
    "kw": "llm gpt 大模型 对话 chat glm 生成"
  },
  "agent": {
    "name": "通用智能体",
    "cat": "agent",
    "icon": "sparkles",
    "caps": [
      "mcp",
      "skill"
