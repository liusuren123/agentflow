        "n": "结果",
        "t": "text"
      },
      {
        "n": "会话引用",
        "t": "object"
      }
    ],
    "params": [
      {
        "k": "model",
        "l": "模型",
        "t": "combo",
        "o": [
          "GLM-4.7",
          "GLM-4.7-Air",
          "GLM-4.6-Flash",
          "DeepSeek-V4",
          "GPT-5",
          "Claude Sonnet 4.5"
        ],
        "d": "GLM-4.7"
      },
      {
        "k": "sys",
        "l": "系统提示词",
        "t": "textarea",
        "d": "你是通用智能体，围绕用户目标自主推进，工具调用前评估必要性。"
