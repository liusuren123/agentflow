# AgentFlow 执行后端配置（复制为 .env 后填写）
# ── 方式一：任意 OpenAI 兼容端点（推荐，支持 GLM/DeepSeek/OpenAI/Ollama/LM Studio…）──
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_API_KEY=your-key
# AI_MODEL=glm-4.7
# AI_MODELS=GLM-4.7:glm-4.7,GLM-4.7-Air:glm-4.7-air,GLM-4.6-Flash:glm-4.6-flash
# AI_PROVIDER_NAME=agentflow

# ── 方式二：内置端点自动探测（设置对应密钥即可，无需 BASE_URL）──
# DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=

# ── 可选 ──
# BOCHA_API_KEY=            # 博查搜索（网页搜索节点真实联网；缺省尝试 DuckDuckGo）
# SEARXNG_URL=            # SearXNG 自托管实例根 URL（网页搜索节点 eng=SearXNG；缺省该引擎如实跳过）
# ALLOW_PRIVATE_NET=1       # 允许 HTTP 节点访问内网/回环地址（默认拦截，防 SSRF）
# PORT=3000
