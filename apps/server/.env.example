# AgentFlow 执行后端配置（复制为 .env 后填写）
# ── 方式一：任意 OpenAI 兼容端点（推荐，支持 GLM/DeepSeek/OpenAI/Ollama/LM Studio…）──
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_API_KEY=your-key
# AI_MODEL=glm-4.7
# AI_MODELS=GLM-4.7:glm-4.7,GLM-4.7-Air:glm-4.7-air,GLM-4.6-Flash:glm-4.6-flash
# AI_PROVIDER_NAME=agentflow

# ── 方式二：内置端点自动探测（设置对应密钥即可，无需 BASE_URL）──
# DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=

# ── 可选 ──
# BOCHA_API_KEY=            # 博查搜索（网页搜索节点真实联网；缺省尝试 DuckDuckGo）
# SEARXNG_URL=            # SearXNG 自托管实例根 URL（网页搜索节点 eng=SearXNG；缺省该引擎如实跳过）
# MCP_HTTP_SERVERS=         # 外部 MCP server 注册表（HTTP 端点）：逗号分隔 name=url，如 name1=https://host/mcp,name2=…（ADR-0012 / BK-0029）
# MCP_STDIO_SERVERS=        # 外部 MCP server 注册表（stdio 命令）：逗号分隔 name=命令 参数，如 name1=npx --yes @modelcontextprotocol/server-sqlite --db-path …,name2=…
# ALLOW_PRIVATE_NET=1       # 允许 HTTP 节点访问内网/回环地址（默认拦截，防 SSRF）
# PTY_ENABLED=0             # PTY 会话功能总开关（默认 0 关；启用主权在运维，ADR-0014）
# PTY_IDLE_TIMEOUT_MS=600000    # PTY 会话 idle 超时（ms，下限 1000）
# PTY_MAX_SESSION_MS=3600000    # PTY 会话时长硬顶（ms，须 ≥ idle 超时）
# PTY_MAX_SESSIONS=4        # PTY 并发会话数上限（1-16）
# MEMORY_ENABLED=0          # 跨 run 记忆工具组总开关（默认 0 关；=1 时 llm 节点注入 memory_get/set/list，全局 KV 无按工作流隔离，明文落 data/agentflow.db——ADR-0024 / issue#17）
# ON_ERROR=skip             # 节点失败全局策略：skip（跳过，默认）/ retry（重试）/ abort（中止 fail-fast）（ADR-0022 / BK-0020）
# ON_ERROR_RETRIES=0        # retry 策略重试次数上限（整数 0-5，默认 0；仅 ON_ERROR=retry 消费）
# ON_ERROR_RETRY_DELAY_MS=1000   # retry 退避基值 ms（整数 0-60000，默认 1000；指数退避 ×2^(n-1)，单次封顶 30000ms）
# PORT=3000
