{
  "name": "agentflow",
  "version": "1.0.0",
  "private": true,
  "description": "AgentFlow · ComfyUI 风格智能体工作流（宪法门禁：UI 1:1）",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gate": "node tools/pixel-gate/gate.mjs",
    "gate:update": "node tools/pixel-gate/gate.mjs --update",
    "build:shared": "npm run build -w @agentflow/shared",
    "test": "npm run build:shared && npm test -w @agentflow/shared",
    "dev:server": "npm run build:shared && npm start -w @agentflow/server"
  },
  "devDependencies": {
    "pixelmatch": "^6.0.0",
    "playwright": "^1.50.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0"
  }
}
