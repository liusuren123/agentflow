{
  "name": "agentflow",
  "version": "1.0.0",
  "private": true,
  "description": "AgentFlow · ComfyUI 风格智能体工作流（宪法门禁：UI 1:1）",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gate": "node tools/pixel-gate/gate.mjs",
    "gate:update": "node tools/pixel-gate/gate.mjs --update",
    "build:shared": "npm run build -w @agentflow/shared",
    "build:web": "npm run build -w @agentflow/web",
    "build:server": "npm run build -w @agentflow/server",
    "build": "npm run build:shared && npm run build:web",
    "start": "npm run build && npm run build:server && npm start -w @agentflow/server",
    "test": "npm run build:shared && npm run build:server && npm test -w @agentflow/shared",
    "smoke:server": "node tests/smoke/smoke-server.mjs",
    "smoke:pty": "node tests/smoke/pty-sessions.mjs",
    "smoke:shutdown": "node tests/smoke/shutdown-sigterm.mjs",
    "smoke:mcp": "node tests/smoke/mcp-transport.mjs",
    "smoke:mcp:registry": "node tests/smoke/mcp-registry.mjs",
    "smoke:mcp:inject": "node tests/smoke/mcp-inject.mjs",
    "test:canvas": "node tests/canvas/geometry.mjs",
    "test:pty-e2e": "node tests/e2e/pty-echo-matrix.mjs",
    "dev:web": "npm start -w @agentflow/web",
    "dev:server": "npm run build:shared && npm run build:server && npm start -w @agentflow/server"
  },
  "devDependencies": {
    "pixelmatch": "^6.0.0",
    "playwright": "^1.50.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "node-pty@1.1.0": true
  }
}
